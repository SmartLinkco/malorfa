# Copy to .env.local for local development. Never commit real keys.
# The site builds without these. Contact and newsletter submissions fail
# with a clear error until the required keys are set.
# In Vercel: Project → Settings → Environment Variables.

# Resend — required for the contact form.
# Sending access on notifications.malorfa.com.
RESEND_API_KEY=

# Optional. From address for both contact emails.
# Default: Malorfa Aryee <hello@notifications.malorfa.com>
# RESEND_FROM_EMAIL=Malorfa Aryee <hello@notifications.malorfa.com>

# Optional. Inbox that receives contact notes (reply-to on the confirmation).
# Default: hello@malorfa.com
# CONTACT_ADMIN_EMAIL=hello@malorfa.com

# Buttondown — required for the newsletter form.
# Sent as: Authorization: Token <key>
BUTTONDOWN_API_KEY=
